# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYPAL SANDBOX CONFIGURATION
# Credenciales de PayPal Developer (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# SUPABASE INFRASTRUCTURE (PostgreSQL & Supabase Storage)
# Obtén estas claves en tu panel de Supabase: Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
# CLAVE SERVICE ROLE: Exclusiva para el servidor. NUNCA compartir ni exponer en frontend.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# CLAVE ANON PÚBLICA (opcional si se consulta desde cliente)
SUPABASE_ANON_KEY=""

# ADMINISTRACIÓN SEGURA (Sin contraseñas predeterminadas en código)
# Define una contraseña robusta para acceder a /admin
ADMIN_PASSWORD="define_tu_clave_de_administrador_aqui"
# Clave secreta para firmar tokens de sesión de administrador
ADMIN_SECRET="define_un_token_secreto_para_sesiones_admin"
ADMIN_EMAIL="admin@anomalysound.com"
